NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Hosted staging: use .env.staging.example and a separate Supabase project.
# Never prefix service-role, SMTP, or signing secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
# Alternative legacy name; only one public key variable is required:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
BOOKING_RATE_LIMIT_SALT=replace-with-a-long-random-production-value
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
CONFIRMATION_TOKEN_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-long-random-production-value
APP_ORIGIN=http://localhost:3000
# Production SEO/sharing origin; independent of Auth and billing APP_ORIGIN.
# Defaults to the public Voxa-OS domain in production; local SEO uses APP_ORIGIN.
# VOXA_PUBLIC_SITE_URL=https://os.voxatech.ro
# Optional marketing demo MP4/WebM (local /marketing/demo.mp4 or HTTPS URL).
# Without a video, the actual product screenshots power an interactive walkthrough.
# VOXA_DEMO_VIDEO_URL=/marketing/demo.mp4
# Configure the real activation/support contact before public launch.
# VOXA_SUPPORT_EMAIL=contact@your-domain.example
# Origini HTTPS separate prin virgulă care pot încadra /embed/booking/*.
BOOKING_EMBED_ORIGINS=https://www.clinica.example
NOTIFICATION_PROVIDER=development
# Staff invite delivery is separate from Supabase Auth SMTP:
STAFF_INVITATION_PROVIDER=manual
# Use a provider that permits transactional email; ordinary Zoho Mail does not.
# Named production configuration: docs/TRANSACTIONAL_EMAIL_SETUP.md.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=login-shown-by-provider@smtp-brevo.com
# SMTP_PASSWORD=dedicated-smtp-key-not-api-key
# SMTP_FROM=noreply@notify.your-domain.example
# SMTP_REPLY_TO=contact@your-domain.example
# ERROR_ALERT_EMAIL=operations@your-domain.example
# NOTIFICATION_PROVIDER=smtp supports email, not SMS.
NOTIFICATION_DELIVERY_ENABLED=false
# 1..25 jobs per worker invocation; SMTP defaults to 10.
NOTIFICATION_BATCH_SIZE=10
# Optional dedicated server-only receipt key; service role key is the fallback.
# DOCUMENT_UPLOAD_SECRET=long-random-server-only-secret
# Enable sandbox only on staging, live only on production with matching keys.
STRIPE_BILLING_ENABLED=false
STRIPE_BILLING_MODE=sandbox
# STRIPE_SECRET_KEY=server-only-key-matching-the-billing-mode
# STRIPE_ACCOUNT_ID=account-id-for-that-mode
# STRIPE_PRICE_ID=monthly-eur-price-in-that-account
# STRIPE_ANNUAL_PRICE_ID=annual-eur-14999-price-in-that-account
# STRIPE_WEBHOOK_SECRET=signing-secret-for-the-corresponding-endpoint
# STRIPE_PORTAL_CONFIGURATION_ID=portal-configuration-in-that-account
# Operator-only encrypted recovery snapshots; never upload these to Vercel.
# BACKUP_ENCRYPTION_KEY=64-random-hex-characters
# Patient encryption: server-only JSON keyring, separate from backup/token keys.
# Generate locally with: node --conditions=react-server scripts/patient-encryption.mjs generate staging
# Copy the generated value to the corresponding private server environment.
# PATIENT_ENCRYPTION_KEYRING={"active":"v1","keys":{"v1":"64-random-hex-characters"},"index":"different-64-random-hex-characters"}
# Set true only during the coordinated conversion of existing Storage objects.
PATIENT_ENCRYPTION_READ_LEGACY=false
# Temporary coordinated rollout window; clear after conversion/verification.
PATIENT_ENCRYPTION_MAINTENANCE=false
# Optional server-only adapter (see docs/HOSTED_STAGING.md):
# STAFF_INVITATION_PROVIDER_URL=https://email-adapter.example/invitations
# STAFF_INVITATION_PROVIDER_TOKEN=replace-with-server-only-token
# Production adapter, when NOTIFICATION_PROVIDER=webhook:
# NOTIFICATION_PROVIDER_URL=https://provider.example/send
# NOTIFICATION_PROVIDER_TOKEN=replace-with-provider-token
