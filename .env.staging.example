# Copy to .env.staging.local. Never copy the production env file.
APP_ENVIRONMENT=staging
STAGING_SUPABASE_PROJECT_REF=replace-with-new-project-ref
STAGING_VERCEL_PROJECT=voxa-os-staging
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-new-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
# Legacy alternative (only one public key is required):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-server-secret
APP_ORIGIN=https://replace-with-stable-staging-domain.vercel.app
BOOKING_RATE_LIMIT_SALT=replace-with-distinct-random-32-plus-character-secret
CONFIRMATION_TOKEN_SECRET=replace-with-distinct-random-32-plus-character-secret
CRON_SECRET=replace-with-distinct-random-32-plus-character-secret
NOTIFICATION_PROVIDER=development
STAFF_INVITATION_PROVIDER=manual
# Stripe sandbox only. The application rejects live keys and non-staging targets.
STRIPE_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=restricted-test-key-with-minimum-billing-permissions
# STRIPE_ACCOUNT_ID=connected-sandbox-account-id
# STRIPE_PRICE_ID=sandbox-recurring-price-id
# STRIPE_WEBHOOK_SECRET=endpoint-signing-secret
# STRIPE_PORTAL_CONFIGURATION_ID=sandbox-portal-configuration-id
# STRIPE_WEBHOOK_ENDPOINT_ID=sandbox-endpoint-id
# Operator-only bypass for the protected staging webhook; never expose its URL:
# STRIPE_STAGING_BYPASS_SECRET=staging-webhook-automation-secret
# Optional authenticated HTTPS staff email adapter (server-only):
# STAFF_INVITATION_PROVIDER_URL=https://email-adapter.example/invitations
# STAFF_INVITATION_PROVIDER_TOKEN=replace-with-server-only-adapter-token
# Operator-only; do NOT add these credentials to Vercel or NEXT_PUBLIC variables:
# SUPABASE_ACCESS_TOKEN=replace-with-personal-access-token
# SUPABASE_DB_PASSWORD=replace-with-staging-database-password
# Optional local-only Vercel protection bypass for the dedicated staging project:
# STAGING_PREVIEW_BYPASS_SECRET=replace-with-staging-project-automation-secret
# Local operator-only SMTP configuration, applied to Supabase Auth, never Vercel:
# STAGING_SMTP_HOST=your-provider-smtp-host
# STAGING_SMTP_PORT=587
# STAGING_SMTP_USER=sender@example.ro
# STAGING_SMTP_PASSWORD=provider-application-specific-password
# STAGING_SMTP_SENDER=sender@example.ro
# STAGING_SMTP_SENDER_NAME=Voxa-OS staging
# Controlled test inboxes, also local-only:
# STAGING_TEST_OWNER_A_EMAIL=first-controlled-inbox@example.ro
# STAGING_TEST_OWNER_B_EMAIL=second-controlled-inbox@example.ro
