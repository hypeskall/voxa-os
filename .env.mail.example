# Copy to ignored .env.mail.local. Enter the SMTP key privately; never in chat.
MAIL_PROVIDER=brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace-with-login-shown-by-brevo
SMTP_PASSWORD=replace-with-brevo-smtp-key-not-api-key
SMTP_FROM=noreply@notify.voxatech.ro
SMTP_REPLY_TO=contact@voxatech.ro
AUTH_EMAIL_HOURLY_LIMIT=10
# Set only after Brevo domain authentication and exact-destination approval.
MAIL_DOMAIN_VERIFIED=false
MAIL_CONFIGURATION_APPROVED=false
MAIL_APPROVED_PROJECT_REF=replace-with-approved-project-reference
