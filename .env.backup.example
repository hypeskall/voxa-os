# Copy to ignored .env.backup.local on the trusted backup operator/runner only.
# Create a private R2 Standard bucket with EU jurisdiction; no r2.dev/custom domains.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=voxa-private-backups
R2_JURISDICTION=eu
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-s3-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
# A separate read-only management token for R2 bucket/domain privacy readback.
CLOUDFLARE_API_TOKEN=replace-with-r2-bucket-read-management-token
# Keep false until the owner authorizes the exact account/bucket/project transfer.
R2_UPLOAD_APPROVED=false
R2_APPROVED_PROJECT_REF=replace-with-approved-project-reference
# Backup decryption keys remain separate in the named source environment.
