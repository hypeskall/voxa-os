# Install ONLY in hypeskall/voxa-backup-runner after explicit credential-destination approval.
# Replace REVIEWED_VOXA_COMMIT with the tested 40-character Voxa commit. Never track main.
name: Private Voxa encrypted backup
on:
  schedule:
    - cron: '17 0 * * *'
  workflow_dispatch:
    inputs:
      test_failure:
        description: Deliberate failure-alert test without reading production data
        type: boolean
        default: false
permissions:
  contents: read
concurrency:
  group: voxa-production-backup
  cancel-in-progress: false
jobs:
  backup:
    if: github.repository == 'hypeskall/voxa-backup-runner' && github.event.repository.private == true
    runs-on: ubuntu-latest
    timeout-minutes: 12
    steps:
      - name: Controlled failure-alert test
        if: inputs.test_failure == true
        run: |
          echo 'Deliberate notification test; production data and secrets are not accessed.'
          exit 1
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          repository: hypeskall/voxa-os
          ref: REVIEWED_VOXA_COMMIT
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24
      - name: Install reviewed locked dependencies before loading private credentials
        run: npm ci --ignore-scripts --no-audit --no-fund
      - name: Capture and verify encrypted production backup
        env:
          GITHUB_TOKEN: ${{ github.token }}
          PRIVATE_BACKUP_RUNNER_APPROVED: ${{ vars.PRIVATE_BACKUP_RUNNER_APPROVED }}
          SUPABASE_BACKUP_READ_TOKEN: ${{ secrets.SUPABASE_BACKUP_READ_TOKEN }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          BACKUP_ENCRYPTION_KEY: ${{ secrets.BACKUP_ENCRYPTION_KEY }}
          R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
          R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
        run: |
          node scripts/backup-ci-env.mjs
          npm run backup:run
      - name: Remove temporary credential files
        if: always() && inputs.test_failure != true
        run: node scripts/backup-ci-env.mjs cleanup
# No archives, receipts, private values or dependency caches are uploaded as GitHub artifacts.
# Failure alerts require verified owner Actions notification settings. No SMTP key is exported.
